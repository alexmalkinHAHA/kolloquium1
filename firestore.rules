rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ЗАМЕНИТЕ на свой email — тот, с которым вы создадите пользователя
    // в Firebase Authentication (Email/Password). Должен совпадать
    // со значением window.ADMIN_EMAIL в config.js.
    function isTeacher() {
      return request.auth != null && request.auth.token.email == "malkin.ai@misis.ru";
    }

    match /students/{loginId} {
      allow create, update: if request.resource.data.keys().hasAll(['login', 'name', 'group'])
                              && request.resource.data.login is string
                              && request.resource.data.name is string
                              && request.resource.data.group is string;
      allow get: if true;
      allow list: if isTeacher();
      allow delete: if isTeacher();
    }

    match /submissions/{docId} {
      allow create: if request.resource.data.keys().hasAll(['login','taskKey','problemId'])
                     && request.resource.data.login is string
                     && request.resource.data.taskKey is string
                     && request.resource.data.problemId is string;
      // Студент может дополнять свою же запись (попытка, ответ, фото),
      // но не может переписать чужую.
      allow update: if request.resource.data.login == resource.data.login;
      allow get, list: if isTeacher();
      allow delete: if isTeacher();
    }
  }
}
